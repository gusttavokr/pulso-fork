FROM node:22-slim AS build
WORKDIR /app

RUN npm install -g @angular/cli@21

COPY ../frontend/pulso/package*.json ./
RUN npm install

COPY ../frontend/pulso ./
RUN ng build --configuration production

FROM nginx:alpine
WORKDIR /usr/share/nginx/html

RUN rm -rf ./*


COPY --from=build /app/dist/pulso/browser ./

COPY ../frontend/pulso/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
