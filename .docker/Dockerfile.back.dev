FROM maven:3.8.4-openjdk-17-slim

WORKDIR /app


COPY ../backend/pulso/pom.xml ./pom.xml
COPY ../backend/pulso/mvnw ./
COPY ../backend/pulso/.mvn ./.mvn

RUN chmod +x mvnw

COPY ../backend/pulso/src ./src

ENV SPRING_PROFILES_ACTIVE=dev \
    TZ=America/Sao_Paulo

EXPOSE 8080

CMD ["mvn", "spring-boot:run"]
